# MongoDB connection string (local: mongodb://127.0.0.1:27017/spotify-project, or your Atlas URI)
MONGO_URI=
# Long random string used to sign login tokens, e.g. run: node -e "console.log(require(\x27crypto\x27).randomBytes(48).toString(\x27hex\x27))"
JWT_SECRET=
PORT=3000
# Set to production when serving the built client from Express over HTTPS
NODE_ENV=development
